# Logger
LOG_LEVEL=info
LOG_FORMAT=text
LOG_ADD_SOURCE=true

# HTTP
HTTP_HOST=0.0.0.0
HTTP_PORT=3434
HTTP_READ_TIMEOUT=5s
HTTP_READ_HEADER_TIMEOUT=2s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=120s
HTTP_MAX_HEADER_BYTES=1048576

# Middleware
MW_CORS_ENABLED=true
MW_CORS_ALLOW_ORIGINS=*
MW_CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
MW_CORS_ALLOW_HEADERS=Content-Type, Authorization
MW_CORS_ALLOW_CREDENTIALS=false
MW_LOGGER_ENABLED=true
MW_RECOVER_ENABLED=true
MW_RECOVER_STACK=true
MW_RECOVER_MESSAGE=internal server error

# Service
JWT_SECRET=change-me-in-prod
JWT_TTL=24h
SERVICE_MIN_PASSWORD_LENGTH=8
SERVICE_DEFAULT_SEVERITY=critical
SERVICE_MAX_HISTORY_LIMIT=1000
SERVICE_DEFAULT_HISTORY_LIMIT=100

# Cassandra
CASSANDRA_HOSTS=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=neohome
CASSANDRA_DATACENTER=datacenter1
CASSANDRA_USERNAME=
CASSANDRA_PASSWORD=
CASSANDRA_CONNECT_TIMEOUT=5s
CASSANDRA_QUERY_TIMEOUT=5s
CASSANDRA_CONSISTENCY=quorum

# MQTT
MQTT_ENABLED=true
MQTT_BROKER=tcp://127.0.0.1:1883
MQTT_CLIENT_ID=neohome-api
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_TELEMETRY=neohome/devices/+/telemetry
MQTT_QOS=1
MQTT_CONNECT_TIMEOUT=5s
MQTT_HANDLER_TIMEOUT=5s
MQTT_RECONNECT_INTERVAL=2s
MQTT_DISCONNECT_WAIT_MS=250
